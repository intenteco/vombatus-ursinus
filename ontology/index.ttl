qualia:vombatus_ursinus a dcat:Dataset ;
    dct:title "Vombatus ursinus (Bare-Nosed / Common Wombat) Species Hypermedia Dataset"@en ;
    dct:description "Authoritative taxonomic, UBERON anatomical, fossorial osteology/myology, pelvic dermal rump-shield, distal-colon cubic-scat biomechanics, joint ROM, InstanceState64 ontogeny, grazing ecology, and biocultural Country dataset for Vombatus ursinus (Shaw, 1800) across South-Eastern Australia."@en ;
    dct:identifier <urn:qualia:taxon:vombatus_ursinus> , <did:q42:taxon:vombatus_ursinus> ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    dct:hasPart member:taxon-ttl ,
                member:taxon-q42 ,
                member:index-q42 ,
                member:claims-ledger ,
                member:organ-osteology ,
                member:organ-myology ,
                member:organ-integument-visceral ,
                member:cad-vibe-planned ,
                member:hmc-package-planned .

member:taxon-ttl a dcat:Distribution ;
    dct:title "Taxon & Biophysical Ontology Source (Turtle 1.1)"@en ;
    dct:format "text/turtle" ;
    dcat:accessURL <file:ontology/taxon.ttl> ;
    q42:lifecycleStatus "authored_eco_wp_07a" .

member:taxon-q42 a dcat:Distribution ;
    dct:title "Sealed Taxon & Biophysical NQuin Volume (.q42)"@en ;
    dct:format "application/vnd.qualia.q42" ;
    dcat:accessURL <file:dist/taxon.q42> ;
    prov:wasDerivedFrom member:taxon-ttl ;
    q42:lifecycleStatus "compiled_eco_wp_07a" .

member:index-q42 a dcat:Distribution ;
    dct:title "Sealed DCAT Package Index NQuin Volume (.q42)"@en ;
    dct:format "application/vnd.qualia.q42" ;
    dcat:accessURL <file:dist/index.q42> ;
    q42:lifecycleStatus "compiled_eco_wp_07a" .

