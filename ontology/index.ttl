rel:working a dcat:Dataset ;
    dct:isVersionOf qualia:vombatus_ursinus ;
    dct:identifier "working-eco-wp-07a" ;
    rdfs:comment "Single species HMC architecture: individuals instantiate Vombatus ursinus via InstanceState64 (seed, ontogenetic_age_norm, height_scale, site_vigor, environmental_stress) across stages {pouch_young, juvenile_at_heel, subadult, adult_female, adult_male}."@en .

