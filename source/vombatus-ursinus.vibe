// Bare-Nosed Wombat Low Raspy Defensive Grunt & Hiss (110-420 Hz) -> .qac
let raw_growl_fund = capability.invoke("hypermedia.acoustics.synthesize_tone", {
    frequency: 112.0,
    sample_rate: 48000,
    frames: 24000,
    amplitude: 0.45
});
let filt_growl_fund = capability.invoke("hypermedia.acoustics.filter_biquad", {
    audio: raw_growl_fund,
    mode: "bandpass",
    cutoff_hz: 165.0,
    q: 1.1,
    gain_db: 1.5
});
let raw_rasp_harm = capability.invoke("hypermedia.acoustics.synthesize_tone", {
    frequency: 340.0,
    sample_rate: 48000,
    frames: 24000,
    amplitude: 0.28
});
let filt_rasp_harm = capability.invoke("hypermedia.acoustics.filter_biquad", {
