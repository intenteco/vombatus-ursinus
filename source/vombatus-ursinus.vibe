    cutoff_hz: 380.0,
    q: 1.4,
    gain_db: 0.5
});
let call_mix = capability.invoke("hypermedia.acoustics.mix_tracks", {
    tracks: [
        { audio: filt_growl_fund, gain: 0.90, offset_seconds: 0.0, fade_in_seconds: 0.03, fade_out_seconds: 0.14 },
        { audio: filt_rasp_harm,  gain: 0.72, offset_seconds: 0.04, fade_in_seconds: 0.05, fade_out_seconds: 0.18 }
    ],
    master_gain: 0.9
});
let wombat_qac = capability.invoke("hypermedia.acoustics.encode_aac", {
    audio: call_mix,
    bitrate: 96000,
    format: "qac",
    species_id: "urn:qualia:taxon:vombatus_ursinus",
    cue_profile: "acoustic_pcm_stft_hoa_modal_v1"
});

